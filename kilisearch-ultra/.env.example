# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed or served — see storage/uploads/.htaccess-style
# denial rule for it in the app root .htaccess.
#
# List of configured connection profile names (comma-separated). Each name
# gets its own KILI_DB_<NAME>_* block below.
KILI_DB_PROFILES=

# Example profile named "default":
# KILI_DB_DEFAULT_DRIVER=postgres
# KILI_DB_DEFAULT_HOST=127.0.0.1
# KILI_DB_DEFAULT_PORT=5432
# KILI_DB_DEFAULT_DATABASE=
# KILI_DB_DEFAULT_USERNAME=
# KILI_DB_DEFAULT_PASSWORD=
# KILI_DB_DEFAULT_SSL=false
